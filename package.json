		"eslint": "^8.57.1",
		"eslint-config-prettier": "^8.5.0",
		"eslint-plugin-svelte": "^3.23.0",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.56.9",
		"svelte-check": "^4.7.6",
